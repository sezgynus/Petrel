# Petrel runtime configuration.
# Values use systemd EnvironmentFile syntax, not shell syntax.
MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_API_KEY=
PETREL_REQUEST_TIMEOUT=5
# Verify this UART is routed to the display's RX/TX pins on your Pi model.
PETREL_SERIAL_PORT=/dev/ttyS0
# BCM numbers, in the same A/B order as --encoder-pins.
PETREL_ENCODER_PINS="21 19"
PETREL_BUTTON_PIN=20
PETREL_SETTINGS_FILE=~/.config/Petrel/presets.json

# Moonraker [power <name>] device controlled by the encoder button.
PETREL_POWER_DEVICE=Printer
# Hold time in milliseconds. Set to 0 to request power-on immediately on button press.
PETREL_POWER_ON_HOLD_MS=2000

# Optional screenshot capture and browser display/control, prompted by configure.sh.
# New configurations default both off; remote display also activates the emulator.
PETREL_EMULATOR=0
PETREL_REMOTE=0

# Optional Klipper extra: configure using ./configure.sh (first prompt default: on).
# Editing this preference alone does not install/remove the extra or config.
PETREL_AXIS_TRAVEL=1
# configure.sh stores absolute paths appropriate to the installation user:
# PETREL_KLIPPER_DIR=/home/user/klipper
# PETREL_PRINTER_CONFIG=/home/user/printer_data/config/printer.cfg
